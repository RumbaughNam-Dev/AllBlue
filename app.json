{
  "expo": {
    "name": "AllBlue",
    "slug": "allblue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allblue",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#144A84",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rumbaugh.allblue",
      "backgroundColor": "#144A84",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rumbaugh.allblue",
      "backgroundColor": "#144A84",
      "adaptiveIcon": {
        "backgroundColor": "#035491",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c5245e84-3569-4e55-b9d3-b1a3375569e9",
      "enabled": true,
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#144A84"
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#144A84"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5245e84-3569-4e55-b9d3-b1a3375569e9"
      }
    },
    "owner": "rumbaugh"
  }
}
